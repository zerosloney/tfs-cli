    "tfs-cli": "node bin/tfs-cli.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "tfs",
    "tfvc",
    "tf.exe",
    "ai-agent",
    "cli",
    "json",
    "opencode",
    "trae",
